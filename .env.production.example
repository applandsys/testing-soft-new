# Copy to .env on the server:  cp .env.production.example .env
# Then fill in every value marked CHANGE_ME. Never commit the real .env.

APP_NAME="Testing Soft"
APP_ENV=production
# Generate with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE_ME
APP_DEBUG=false
# The server's public IP plus the port from HTTP_BIND, e.g. http://203.0.113.10:5000
APP_URL=http://CHANGE_ME_SERVER_IP:5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr sends Laravel logs to `docker compose logs app`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# DB_HOST/DB_PORT are set by docker-compose.yml (the `db` container).
DB_DATABASE=testing_software
# Must NOT be "root" - the MySQL image creates this user for the app.
DB_USERNAME=testing_soft
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep false: the site is served over plain http (IP + port). Login breaks if true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The app has no queued jobs and no worker container; run jobs inline.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Run `php artisan migrate --force` every time the app container starts.
RUN_MIGRATIONS=true

# Host port the site is published on: http://SERVER_IP:5000
# Must match the port in APP_URL.
HTTP_BIND=5000
