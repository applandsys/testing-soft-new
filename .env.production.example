# Copy to .env on the server:  cp .env.production.example .env
# Then fill in every value marked CHANGE_ME. Never commit the real .env.

APP_NAME="Testing Soft"
APP_ENV=production
# Generate with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr sends Laravel logs to `docker compose logs app`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# DB_HOST/DB_PORT are set by docker-compose.yml (the `db` container).
DB_DATABASE=testing_software
# Must NOT be "root" - the MySQL image creates this user for the app.
DB_USERNAME=testing_soft
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over HTTPS (otherwise login breaks on plain http).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The app has no queued jobs and no worker container; run jobs inline.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Run `php artisan migrate --force` every time the app container starts.
RUN_MIGRATIONS=true

# Port mapping for the web container. 80 = serve directly.
# Use 127.0.0.1:8080 when a host Nginx + Certbot terminates HTTPS.
HTTP_BIND=80
